    <!--  DROP ZONE (purple area — delivery target)                 -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <model name="drop_zone">
      <static>true</static>
      <pose>7.5 13 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.0 2.0 0.02</size></box></geometry>
          <material>
            <ambient>0.5 0.2 0.6 1</ambient>
            <diffuse>0.6 0.3 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  COLLECTIBLE OBJECTS (golden cylinders)                    -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <model name="object_0">
      <static>true</static>
      <pose>4 2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
